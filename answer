                                                       'parsedAnswer);\n'
                                                       '        '
                                                       's_widget_custom.goBack();\n'
                                                       '        '
                                                       's_widget_custom.toggleVisbility();\n'
                                                       '    };\n'
                                                       '    '
                                                       's_widget_custom.search '
                                                       '= () => {\n'
                                                       '        '
                                                       'clearTimeout(delayTimer);\n'
                                                       '        delayTimer = '
                                                       'setTimeout(async '
                                                       'function () {\n'
